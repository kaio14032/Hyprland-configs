{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,
    "margin-top": 4,
    "margin-bottom": 0,
    "margin-left": 4,
    "margin-right": 4,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["network", "pulseaudio", "cpu", "memory", "battery", "tray"],
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },
    "hyprland/window": {
        "max-length": 40,
        "format": "{title}"
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a, %d %b %Y %H:%M}",
        "tooltip-format": "{:%A, %d de %B de %Y}"
    },
    "network": {
        "format-wifi": " {signalStrength}%",
        "format-ethernet": "󰈁",
        "format-disconnected": "󰤮",
        "tooltip-format": "{ifname}: {essid} ({ipaddr})"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 {volume}%",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "cpu": {
        "interval": 2,
        "format": "󰻠 {usage}%",
        "tooltip-format": "Load: {load}"
    },
    "memory": {
        "interval": 2,
        "format": "󰍛 {percentage}%",
        "tooltip-format": "{used} GiB / {total} GiB"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "tray": {
        "spacing": 8
    }
}
